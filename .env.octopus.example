# Octopus Energy Dashboard Configuration
# Copy this file to .env and update with your actual values

# Octopus Energy API Configuration
# Get your API key from: https://octopus.energy/dashboard/new/accounts/personal-details/api-access
OCTOPUS_API_KEY=sk_live_your_api_key_here

# Your Octopus account number (found in your Octopus Energy account)
# This is used to automatically detect current tariffs and meter details
OCTOPUS_ACCOUNT_NUMBER=A-12345678

# Optional: Manual meter configuration (will be auto-detected if not provided)
# Only needed if auto-detection fails or you want to override
# MPAN=your_mpan_number_here
# METER_SERIAL_NUMBER=your_meter_serial_number_here

# Note: Tariff codes are now automatically detected from your account
# No need to manually configure IMPORT_TARIFF_CODE, EXPORT_TARIFF_CODE, etc.
# The system will automatically detect your current import and export tariffs

# Database Configuration (existing)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=victron
DB_USER=admin
DB_PASSWORD=your_password_here

# Dashboard Configuration
DASHBOARD_PORT=3001

# MQTT Configuration (existing Victron setup)
MQTT_BROKER=mqtt://your-victron-gx-device-ip:1883
DEVICE_ID=your-device-id

# EV Charger Configuration (Victron EVCS)
# Instance number of your EVCS on the GX device (usually 0)
# Run node src/discover-topics.js to find the correct instance
EV_CHARGER_INSTANCE=0

# Smart Controller Configuration
# These override the database tariff settings when running victron.smart.controller.js
# IMPORTANT: Disable DESS in VRM before using the smart controller!

# Anti-export threshold: grid power (W) below this triggers anti-export (negative = exporting)
# ANTI_EXPORT_THRESHOLD=-100
# Import bias: small positive setpoint to prevent export during non-peak (W)
# IMPORT_BIAS_WATTS=50
# Max battery charge rate from grid (W)
# MAX_GRID_CHARGE_WATTS=3000
# Max battery discharge/export rate (W, positive number)
# MAX_EXPORT_WATTS=12000
# Night charging target SOC (%)
# NIGHT_TARGET_SOC=100
# Peak discharge minimum SOC (%)
# PEAK_MIN_SOC=10
# Evening minimum SOC before importing from grid (%)
# EVENING_MIN_SOC=15
# Minimum solar surplus (W) before diverting to EV
# EV_SOLAR_SURPLUS_MIN=1400
# Minimum EV charging current (A)
# EV_MIN_CURRENT=6
# Maximum EV charging current (A)
# EV_MAX_CURRENT=32
# Battery SOC threshold for allowing EV charging from battery (%)
# EV_BATTERY_SOC_THRESHOLD=50
# Strategy evaluation interval (ms)
# STRATEGY_INTERVAL=30000
# Anti-export feedback interval (ms)
# FEEDBACK_INTERVAL=15000
# Rate classification thresholds (p/kWh). Leave at 0 to auto-calculate from daily spread
# CHEAP_RATE_PENCE=0
# EXPENSIVE_RATE_PENCE=0
# Rate refresh interval from Octopus API (ms). Default: 1 hour
# RATE_REFRESH_INTERVAL=3600000
# Solar power (W) threshold for day-like vs evening-like strategy
# SOLAR_AVAILABLE_THRESHOLD=500

# ─── VRM API (Solar Forecast) ───────────────────────────────────────
# Create a long-lived token at: https://vrm.victronenergy.com/access-tokens
VRM_TOKEN=your_vrm_access_token_here
# Or use email/password (less recommended):
# VRM_EMAIL=your@email.com
# VRM_PASSWORD=your_password
# VRM site ID (auto-detected if omitted):
# VRM_SITE_ID=123456

# ─── Strategy Advisor (LLM) ──────────────────────────────────────────
# Provider: 'openai' (default) or 'gemini'
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini (to switch: set LLM_PROVIDER=gemini)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.0-flash

# Usable battery capacity in kWh (for cost calculations)
# 3x Fogstar ECO 48V 16.1kWh = 48.3kWh nominal, ~43kWh usable
BATTERY_CAPACITY_KWH=43

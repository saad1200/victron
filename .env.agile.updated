# Octopus Agile Controller Environment Variables
# Add these to your main .env file

# Octopus Energy API Authentication
# Get this from your Octopus Energy account dashboard
OCTOPUS_API_KEY=sk_live_your_api_key_here

# Your electricity meter MPAN (Meter Point Administration Number)
# Found on your electricity bill or Octopus account
MPAN=your_mpan_number_here

# Octopus Agile Product and Tariff Codes
# Current Agile product (check Octopus website for latest)
AGILE_PRODUCT_CODE=AGILE-24-10-01

# Your specific Agile tariff code (includes region)
# Format: E-1R-AGILE-PRODUCT-REGION
# Example from your curl command: E-1R-AGILE-24-10-01-J
AGILE_TARIFF_CODE=E-1R-AGILE-24-10-01-J

# Optional: Export tariff code if you have solar export
# Format: E-1R-OUTGOING-PRODUCT-REGION
# EXPORT_TARIFF_CODE=E-1R-OUTGOING-FIX-12M-19-05-13-J

# Existing Victron configuration (should already be in your .env)
MQTT_BROKER=mqtt://your-victron-gx-device-ip:1883
DEVICE_ID=your-device-id
DB_USER=postgres
DB_HOST=localhost
DB_NAME=victron
DB_PASSWORD=your-password
DB_PORT=5433
